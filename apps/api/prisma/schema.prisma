// حفلاتي data model — vendor-ready from day one (hybrid roadmap).
// The 11 wizard categories are ONE polymorphic ServiceOffering table keyed by
// the ServiceCategory enum, which is what makes the wizard + catalog generic.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────
enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum ServiceCategory {
  HALL
  PHOTOGRAPHY
  DECOR
  BEAUTY
  DRESS
  MUSIC
  CATERING
  CAKE
  FLOWERS
  INVITATIONS
  TRANSPORT
}

enum AvailabilityStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum EventType {
  WEDDING
  ENGAGEMENT
  BIRTHDAY
  GRADUATION
  OTHER
}

enum BookingStatus {
  DRAFT
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum DepositStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  GATEWAY
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

// ── Models ───────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String   @unique
  passwordHash String
  fullName     String
  locale       String   @default("ar")
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor            Vendor?   @relation("VendorOwner")
  bookings          Booking[]
  confirmedPayments Payment[] @relation("PaymentConfirmedBy")

  @@index([role])
}

/// In MVP every offering belongs to one seeded platform-owned vendor.
/// Phase 3 attaches real vendor accounts via `userId`.
model Vendor {
  id              String   @id @default(cuid())
  userId          String?  @unique
  name            String
  description     String?
  logoUrl         String?
  phone           String?
  isPlatformOwned Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner     User?             @relation("VendorOwner", fields: [userId], references: [id])
  offerings ServiceOffering[]
}

model ServiceOffering {
  id          String          @id @default(cuid())
  vendorId    String
  category    ServiceCategory
  /// LocalizedString JSON: { ar, fr, en }
  name        Json
  /// LocalizedString JSON: { ar, fr, en }
  description Json
  /// Price in TND (millime precision).
  basePrice   Decimal         @db.Decimal(12, 3)
  emoji       String          @default("✨")
  /// Free-form JSON attributes (capacity / style / theme / includes / type ...).
  attributes  Json            @default("{}")
  imageUrls   String[]        @default([])
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  vendor       Vendor         @relation(fields: [vendorId], references: [id])
  availability Availability[]
  bookingItems BookingItem[]

  @@index([category, isActive])
  @@index([vendorId])
}

/// Date-based availability for DATE_BOUND categories. A confirmed booking
/// flips the relevant days to BOOKED to prevent double-booking.
model Availability {
  id         String             @id @default(cuid())
  offeringId String
  date       DateTime           @db.Date
  status     AvailabilityStatus @default(AVAILABLE)

  offering ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([offeringId, date])
  @@index([date, status])
}

model Booking {
  id            String        @id @default(cuid())
  reference     String        @unique
  userId        String
  eventDate     DateTime      @db.Date
  eventType     EventType
  status        BookingStatus @default(DRAFT)
  /// Snapshotted fiscal totals (TND). Recomputed server-side at creation.
  subtotal      Decimal       @db.Decimal(12, 3)
  tva           Decimal       @db.Decimal(12, 3)
  timbreFiscal  Decimal       @db.Decimal(12, 3)
  total         Decimal       @db.Decimal(12, 3)
  depositAmount Decimal       @db.Decimal(12, 3)
  depositStatus DepositStatus @default(UNPAID)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User          @relation(fields: [userId], references: [id])
  items    BookingItem[]
  payments Payment[]
  invoice  Invoice?

  @@index([userId])
  @@index([status])
  @@index([eventDate])
}

model BookingItem {
  id         String          @id @default(cuid())
  bookingId  String
  offeringId String
  category   ServiceCategory
  unitPrice  Decimal         @db.Decimal(12, 3)
  /// Snapshot of the offering name at booking time (LocalizedString JSON).
  snapshot   Json

  booking  Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  offering ServiceOffering @relation(fields: [offeringId], references: [id])

  @@index([bookingId])
}

/// Payment records: bank-transfer / cash (admin-confirmed) or an online GATEWAY
/// payment (Phase 2). Gateway fields are null for offline payments.
model Payment {
  id                String        @id @default(cuid())
  bookingId         String
  amount            Decimal       @db.Decimal(12, 3)
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  reference         String?
  confirmedByAdminId String?
  /// Gateway integration (Phase 2): which provider, its payment reference, and
  /// the hosted checkout URL the customer was sent to.
  provider          String?
  providerRef       String?       @unique
  checkoutUrl       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking          Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  confirmedByAdmin User?   @relation("PaymentConfirmedBy", fields: [confirmedByAdminId], references: [id])

  @@index([bookingId])
  @@index([status])
}

/// Tunisian-compliant invoice (TVA 19% + Timbre Fiscal). PDF export is Phase 2.
model Invoice {
  id           String   @id @default(cuid())
  bookingId    String   @unique
  number       String   @unique
  issuedAt     DateTime @default(now())
  pdfUrl       String?
  subtotal     Decimal  @db.Decimal(12, 3)
  tva          Decimal  @db.Decimal(12, 3)
  timbreFiscal Decimal  @db.Decimal(12, 3)
  total        Decimal  @db.Decimal(12, 3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}
