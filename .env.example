# ── Database ─────────────────────────────────────────────
# Matches docker-compose.yml credentials.
DATABASE_URL="postgresql://hafalati:hafalati@localhost:5432/hafalati?schema=public"

# ── API ──────────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development
# Hosting platforms (Railway/Render) inject PORT and it wins over API_PORT.
# PORT=4000

# ── Single-service deploy (API also serves the built PWA) ─
# In production (see DEPLOY.md) the API serves apps/web/dist same-origin.
# The Docker image sets these for you; leave unset for local split dev servers.
# SERVE_WEB=true
# WEB_DIST_DIR=/app/apps/web/dist

# JWT secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access-secret-generate-with-openssl-rand-hex-32"
JWT_REFRESH_SECRET="change-me-refresh-secret-generate-with-openssl-rand-hex-32"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# CORS origin (the web PWA dev server)
WEB_ORIGIN="http://localhost:5173"

# ── Fiscal (Tunisia) ─────────────────────────────────────
# TVA rate (19%). Timbre Fiscal is a fixed stamp in TND. Deposit rate on total.
TVA_RATE=0.19
TIMBRE_FISCAL_TND=1.000
DEPOSIT_RATE=0.30

# ── Platform business info (shown on invoices / bank transfer) ──
PLATFORM_NAME="حفلاتي"
PLATFORM_PHONE="+21697580081"
PLATFORM_EMAIL="mahmoudkadri1456@gmail.com"
PLATFORM_ADDRESS="سبيطلة، القصرين، تونس"
BANK_TRANSFER_DETAILS="RIB: 00000000000000000000 — Banque: —"

# ── Public URLs (for gateway return + webhook links) ─────
PUBLIC_WEB_URL="http://localhost:5173"
PUBLIC_API_URL="http://localhost:4000"

# ── Payment gateway (Phase 2) ────────────────────────────
# `mock` needs no credentials and drives local dev + tests.
# Options: mock | konnect | flouci | d17.
PAYMENT_PROVIDER="mock"

# Konnect
KONNECT_API_KEY=""
KONNECT_WALLET_ID=""
KONNECT_BASE_URL="https://api.konnect.network/api/v2"
KONNECT_WEBHOOK_SECRET=""

# Flouci (https://developers.flouci.com)
FLOUCI_APP_TOKEN=""
FLOUCI_APP_SECRET=""
FLOUCI_BASE_URL="https://developers.flouci.com"

# D17 (La Poste Tunisienne). Confirm endpoint/field names against D17 merchant docs.
D17_API_KEY=""
D17_MERCHANT_ID=""
D17_BASE_URL=""

# ── Notifications (Phase 2) ──────────────────────────────
# Email: `console` logs instead of sending (needs no SMTP; dev/test default).
# Set to `smtp` and fill the SMTP_* keys to send real emails.
NOTIFY_PROVIDER="console"
NOTIFY_FROM="حفلاتي <no-reply@hafalati.tn>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""

# Channels a customer notification fans out to (csv): email, sms, whatsapp, telegram.
# A channel with no credentials logs to the console instead of sending.
NOTIFY_CHANNELS="email"

# Twilio (SMS + WhatsApp). Leave empty to log instead of sending.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM="+216..."
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Telegram Bot API. Per-user delivery uses User.telegramChatId; TELEGRAM_OPS_CHAT_ID
# is an optional fallback chat (e.g. the business owner) pinged when a user isn't linked.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_OPS_CHAT_ID=""
# Bot @username (no @) used to build the linking deep link t.me/<username>?start=<code>.
TELEGRAM_BOT_USERNAME=""
# Secret path segment for the Telegram webhook (POST /notifications/telegram/webhook/<secret>).
TELEGRAM_WEBHOOK_SECRET=""

# ── Image uploads ────────────────────────────────────────
# Offering images are stored on disk and served at /uploads. Locally the
# default (apps/api/uploads) is fine. On Railway, point this at a mounted
# volume (e.g. /data/uploads) so images survive redeploys — see DEPLOY.md.
# UPLOAD_DIR="/data/uploads"
MAX_UPLOAD_MB=5

# ── Web (Vite) ───────────────────────────────────────────
VITE_API_URL="http://localhost:4000/api/v1"
