{
  "name": "hafalati",
  "version": "0.1.0",
  "private": true,
  "description": "حفلاتي — Tunisian wedding & events booking platform (PWA + API)",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @hafalati/api prisma:migrate",
    "db:seed": "pnpm --filter @hafalati/api prisma:seed",
    "db:reset": "pnpm --filter @hafalati/api prisma:reset",
    "api": "pnpm --filter @hafalati/api dev",
    "web": "pnpm --filter @hafalati/web dev"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "esbuild"
    ]
  }
}
