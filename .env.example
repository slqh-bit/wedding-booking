# ── Database ─────────────────────────────────────────────
# Matches docker-compose.yml credentials.
DATABASE_URL="postgresql://hafalati:hafalati@localhost:5432/hafalati?schema=public"

# ── API ──────────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development

# JWT secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access-secret-generate-with-openssl-rand-hex-32"
JWT_REFRESH_SECRET="change-me-refresh-secret-generate-with-openssl-rand-hex-32"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# CORS origin (the web PWA dev server)
WEB_ORIGIN="http://localhost:5173"

# ── Fiscal (Tunisia) ─────────────────────────────────────
# TVA rate (19%). Timbre Fiscal is a fixed stamp in TND. Deposit rate on total.
TVA_RATE=0.19
TIMBRE_FISCAL_TND=1.000
DEPOSIT_RATE=0.30

